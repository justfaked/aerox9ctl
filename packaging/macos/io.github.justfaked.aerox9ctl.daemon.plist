<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent: re-applies the Aerox 9 lighting when the mouse wakes up or reconnects.
     Installed by install.sh into ~/Library/LaunchAgents, which replaces @BIN_DIR@ and @LOG_DIR@. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.justfaked.aerox9ctl.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BIN_DIR@/aerox9ctl</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- like systemd's Restart=on-failure / RestartSec=10 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/aerox9ctl-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/aerox9ctl-daemon.log</string>
</dict>
</plist>
