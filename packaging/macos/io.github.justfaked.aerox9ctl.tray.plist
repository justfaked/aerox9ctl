<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent: starts the Aerox 9 battery indicator in the menu bar at login.
     Installed by install.sh into ~/Library/LaunchAgents, which replaces @BIN_DIR@ and @LOG_DIR@. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.justfaked.aerox9ctl.tray</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BIN_DIR@/aerox9ctl-tray</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/aerox9ctl-tray.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/aerox9ctl-tray.log</string>
</dict>
</plist>
